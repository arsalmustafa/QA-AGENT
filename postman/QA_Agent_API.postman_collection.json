          "name": "Ingest lavni",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"talootdev09\",\n  \"repo\": \"lavni\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/repos/ingest",
              "host": ["{{base_url}}"],
              "path": ["repos", "ingest"]
            }
          }
        },
        {
          "name": "Ingest scheduling_agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"afaafaurangzaib\",\n  \"repo\": \"scheduling_agent\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/repos/ingest",
              "host": ["{{base_url}}"],
              "path": ["repos", "ingest"]
            }
          }
        },
        {
          "name": "Upload document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Choose a .md / .pdf / .txt file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents",
              "host": ["{{base_url}}"],
              "path": ["documents"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Ask",
      "item": [
